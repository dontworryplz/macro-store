{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Macro Store",
  "mainBinaryName": "macro-store",
  "version": "0.5.0",
  "identifier": "org.macro.store",
  "build": {
    "frontendDist": "../ui"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["macro-store"]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Macro Store",
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "publisher": "Macro Store",
    "homepage": "https://github.com/turkishcoderxup/macro-store",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright © 2026 Macro Store contributors",
    "category": "Utility",
    "shortDescription": "Flatpak, Snap, Homebrew ve AppImage destekli Linux uygulama mağazası.",
    "longDescription": "Macro Store, Flatpak, Snap, Homebrew ve AppImage kaynaklarını tek ve sade bir arayüzde birleştirir. Sistemde kurulu paketleri algılar; uygulamaları arayın, ayrıntılarını inceleyin, tek tıkla kurun, kaldırın veya güncelleyin. Açık/koyu tema, renk vurguları ve düşük güç modu sunar.",
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "files": {
          "/usr/share/doc/macro-store/copyright": "../LICENSE"
        }
      },
      "rpm": {
        "release": "1",
        "files": {
          "/usr/share/licenses/macro-store/LICENSE": "../LICENSE"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
